/* 底部菜单 */
.bottom-menu.data-v-98733e2a {
  display: flex;
  justify-content: space-around;
  align-items: center;
  background-color: #fff;
  border-top: 1rpx solid #eee;
  position: fixed;
  bottom: 0rpx;
  left: 0;
  right: 0;
  z-index: 999;
  padding-top: 15rpx;
  padding-bottom: 60rpx;
  box-sizing: border-box;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.08);
}
.menu-item.data-v-98733e2a {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 180rpx;
  height: 60rpx;
  border-radius: 10rpx;
  background-color: #f5f5f5;
  color: #333;
  font-size: 28rpx;
  line-height: 60rpx;
  text-align: center;
  cursor: pointer;
  transition: all 0.2s ease;
}

/* 库存项：不可点击，无指针样式 */
.menu-item.stock.data-v-98733e2a {
  cursor: default;
  background-color: #f0f0f0;
  color: #666;
  opacity: 0.8;
}

/* 收藏后变黄 */
.menu-item.collected.data-v-98733e2a {
  background-color: #fff9c4;
  color: #e65100;
  box-shadow: 0 2rpx 8rpx rgba(230, 81, 0, 0.2);
}

/* 按钮悬停效果 */
.menu-item.data-v-98733e2a:active {
  transform: scale(0.98);
  opacity: 0.9;
}