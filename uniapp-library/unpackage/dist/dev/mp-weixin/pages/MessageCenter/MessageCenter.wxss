.notification-page.data-v-6ea3613a {
  min-height: 100vh;
  background: #f5f5f5;
}
.header.data-v-6ea3613a {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  background: #fff;
  border-bottom: 1px solid #eee;
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 10;
}
.header .title.data-v-6ea3613a {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}
.mark-all.data-v-6ea3613a {
  font-size: 28rpx;
  color: #007aff;
  padding: 8rpx 16rpx;
}
.notification-list.data-v-6ea3613a {
  padding: 20rpx 0;
}
.notification-item.data-v-6ea3613a {
  position: relative;
  background: #fff;
  margin: 0 24rpx 20rpx;
  padding: 32rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s;
}
.notification-item.is-read.data-v-6ea3613a {
  opacity: 0.6;
}
.notification-item.data-v-6ea3613a:active {
  transform: scale(0.98);
}
.item-header.data-v-6ea3613a {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}
