/* 页面基础样式 */
.borrow-page.data-v-d10efb47 {
  min-height: 100vh;
  background: linear-gradient(180deg, #f9fbfd 0%, #f5f7fa 100%);
  padding: 30rpx 0 60rpx;
}
.main-content.data-v-d10efb47 {
  width: 92vw;
  margin: 0 auto;
}

/* Header */
.header-section.data-v-d10efb47 {
  margin-bottom: 30rpx;
}
.header-section .title-row.data-v-d10efb47 {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
}
.header-section .title-row .title.data-v-d10efb47 {
  font-size: 36rpx;
  font-weight: 700;
  color: #222;
}
.header-section .title-row .count.data-v-d10efb47 {
  font-size: 28rpx;
  color: #888;
  margin-left: 12rpx;
}
.header-section .divider.data-v-d10efb47 {
  width: 100%;
  height: 3rpx;
  background: linear-gradient(90deg, #2979ff, #70a1ff);
  border-radius: 2rpx;
}

/* Tabs */
.filter-tabs.data-v-d10efb47 {
  display: flex;
  justify-content: space-around;
  background-color: #fff;
  padding: 10rpx 0;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.tab-item.data-v-d10efb47 {
  position: relative;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
  transition: all 0.3s ease;
  cursor: pointer;
}
.tab-item.data-v-d10efb47:hover {
  color: #2979ff;
}
.tab-item.active.data-v-d10efb47 {
  color: #2979ff;
  font-weight: 700;
  transform: scale(1.08);
}
.tab-item .active-line.data-v-d10efb47 {
  position: absolute;
  bottom: -6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 50rpx;
  height: 6rpx;
  background: #2979ff;
  border-radius: 6rpx;
}

/* 列表卡片 */
.card-wrapper.data-v-d10efb47 {
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

/* 状态徽章 */
.status-badge.data-v-d10efb47 {
  padding: 0 20rpx;
  height: 46rpx;
  line-height: 46rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}
.status-badge.status-borrowing.data-v-d10efb47 {
  background: #e6f3ff;
  color: #1a73e8;
}
.status-badge.status-overdue.data-v-d10efb47 {
  background: #ffeaea;
  color: #d93025;
}
.status-badge.status-returned.data-v-d10efb47 {
  background: #f0f0f0;
  color: #777;
}

/* 按钮样式 */
.action-container.data-v-d10efb47 {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
}
.action-btn.data-v-d10efb47 {
  display: inline-block;
  font-size: 26rpx;
  padding: 14rpx 32rpx;
  border-radius: 12rpx;
  transition: all 0.25s ease;
}
.action-btn.renew-btn.data-v-d10efb47 {
  background: linear-gradient(135deg, #2979ff, #5393ff);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(41, 121, 255, 0.3);
}
.action-btn.renew-btn.data-v-d10efb47:active {
  transform: scale(0.95);
  background: #1e64db;
}

/* 空状态 */
.empty-state.data-v-d10efb47 {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 120rpx;
}
.empty-state .empty-text.data-v-d10efb47 {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 50rpx;
}
.empty-state .empty-action.data-v-d10efb47 {
  padding: 18rpx 56rpx;
  background: linear-gradient(135deg, #2979ff, #5393ff);
  color: #fff;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(41, 121, 255, 0.25);
  transition: all 0.3s ease;
}
.empty-state .empty-action.data-v-d10efb47:active {
  transform: scale(0.95);
}