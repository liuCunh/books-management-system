/* 页面基础样式 */
.borrow-page.data-v-fd9fbd1b {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-top: 20rpx;
  padding-bottom: 40rpx;
}
.main-content.data-v-fd9fbd1b {
  width: 92vw;
  margin: 0 auto;
}

/* Header */
.header-section.data-v-fd9fbd1b {
  margin-bottom: 20rpx;
  padding: 10rpx 0;
}
.header-section .title-row.data-v-fd9fbd1b {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}
.header-section .title-row .title.data-v-fd9fbd1b {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}
.header-section .title-row .count.data-v-fd9fbd1b {
  font-size: 28rpx;
  color: #999;
  margin-left: 10rpx;
}
.header-section .divider.data-v-fd9fbd1b {
  width: 100%;
  height: 2rpx;
  background-color: #e0e0e0;
  position: relative;
}

/* Tabs */
.filter-tabs.data-v-fd9fbd1b {
  display: flex;
  justify-content: space-between;
  background-color: #fff;
  padding: 0 20rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}
.tab-item.data-v-fd9fbd1b {
  position: relative;
  padding: 24rpx 10rpx;
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
  transition: all 0.3s;
}
.tab-item.active.data-v-fd9fbd1b {
  color: #2979ff;
  font-weight: bold;
  transform: scale(1.05);
}
.tab-item .active-line.data-v-fd9fbd1b {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background-color: #2979ff;
  border-radius: 6rpx 6rpx 0 0;
}

/* 列表卡片 */
.card-wrapper.data-v-fd9fbd1b {
  line-height: 24px;
  background-color: #fff;
}

/* --- Badge 样式升级 --- */
.status-badge.data-v-fd9fbd1b {
  padding: 0rpx 16rpx;
  height: 44rpx;
  /* 稍微增加高度以容纳文字 */
  line-height: 44rpx;
  border-radius: 5rpx 0 10rpx 0;
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}
.status-badge.status-borrowing.data-v-fd9fbd1b {
  background-color: #e6f7ff;
  color: #1890ff;
  /* 借阅中蓝 */
}
.status-badge.status-overdue.data-v-fd9fbd1b {
  background: linear-gradient(135deg, #fff2f0 0%, #ffccc7 100%);
  color: #d32f2f;
  /* 逾期红 */
}
.status-badge.status-returned.data-v-fd9fbd1b {
  background-color: #f5f5f5;
  color: #999;
  /* 归还灰 */
}

/* --- Right Content 按钮样式 --- */
.action-container.data-v-fd9fbd1b {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
}
.action-btn.data-v-fd9fbd1b {
  display: inline-block;
  font-size: 24rpx;
  padding: 12rpx 28rpx;
  border-radius: 10rpx;
  transition: all 0.2s;
  /* 续借：实心蓝按钮，突出操作 */
}
.action-btn.renew-btn.data-v-fd9fbd1b {
  background-color: #2979ff;
  color: #fff;
}
.action-btn.renew-btn.data-v-fd9fbd1b:active {
  background-color: #1e64db;
}

/* Empty State */
.empty-state.data-v-fd9fbd1b {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 100rpx;
}
.empty-state .empty-text.data-v-fd9fbd1b {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}
.empty-state .empty-action.data-v-fd9fbd1b {
  padding: 16rpx 48rpx;
  background-color: #2979ff;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
}