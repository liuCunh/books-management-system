/* 页面整体背景 */
.collection-page.data-v-7f7803b7 {
  min-height: 100vh;
  background-color: #f5f7fa;
  /* 浅灰背景衬托白色卡片 */
  padding-top: 20rpx;
  padding-bottom: 40rpx;
}

/* 核心居中容器：92vw */
.main-content.data-v-7f7803b7 {
  width: 92vw;
  margin: 0 auto;
}

/* --- 顶部装饰样式 --- */
.header-section.data-v-7f7803b7 {
  margin-bottom: 30rpx;
  padding: 10rpx 0;
}
.header-section .title-row.data-v-7f7803b7 {
  display: flex;
  align-items: baseline;
  /* 文字基线对齐 */
  margin-bottom: 16rpx;
}
.header-section .title-row .title.data-v-7f7803b7 {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}
.header-section .title-row .count.data-v-7f7803b7 {
  font-size: 28rpx;
  color: #999;
  margin-left: 10rpx;
  font-weight: normal;
}
.header-section .divider.data-v-7f7803b7 {
  width: 100%;
  height: 2rpx;
  background-color: #e0e0e0;
  position: relative;
}

/* --- 列表卡片间距 --- */
.card-wrapper.data-v-7f7803b7 {
  line-height: 24px;
  background-color: #fff;
}

/* --- 左侧徽标样式 (保持精致感) --- */
.stock-badge.data-v-7f7803b7 {
  padding: 6rpx 16rpx;
  border-radius: 5rpx 0 10rpx 0;
  /* 仅右下角圆角，贴合左上角 */
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}
.stock-badge.is-available.data-v-7f7803b7 {
  background-color: #e1f3d8;
  color: #67c23a;
}
.stock-badge.is-empty.data-v-7f7803b7 {
  background-color: #f4f4f5;
  color: #909399;
}

/* --- 右侧按钮区域 --- */
.action-container.data-v-7f7803b7 {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
}
.action-btn.data-v-7f7803b7 {
  display: inline-block;
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 10rpx;
  transition: all 0.2s;
}
.action-btn.cancel-btn.data-v-7f7803b7 {
  background-color: #fff;
  color: #ff4d4f;
  border: 1rpx solid #ff4d4f;
}
.action-btn.cancel-btn.data-v-7f7803b7:active {
  background-color: #fff1f0;
  opacity: 0.8;
}

/* --- 空状态优化 --- */
.empty-state.data-v-7f7803b7 {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 100rpx;
}
.empty-state .empty-text.data-v-7f7803b7 {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}
.empty-state .empty-action.data-v-7f7803b7 {
  padding: 16rpx 48rpx;
  background-color: #2979ff;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(41, 121, 255, 0.3);
}