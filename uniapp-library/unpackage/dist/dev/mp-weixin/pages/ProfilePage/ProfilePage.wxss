.container.data-v-7b4c7c70 {
  min-height: 100vh;
  background-color: #f5f7fa;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 20rpx;
  /* 顶层初始间距 */
}

/* 统一设置容器宽度 92vw 且居中 */
.user-header.data-v-7b4c7c70, .menu-card.data-v-7b4c7c70 {
  width: 92vw;
  background-color: #ffffff;
  border-radius: 16rpx;
}

/* 容器间距精准控制为 20rpx */
.section-gap.data-v-7b4c7c70 {
  margin-bottom: 20rpx;
}

/* 用户头部样式 */
.user-header.data-v-7b4c7c70 {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}
.user-header .avatar-box.data-v-7b4c7c70 {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: #eee;
  overflow: hidden;
  margin-bottom: 20rpx;
}
.user-header .avatar-box .avatar.data-v-7b4c7c70 {
  width: 100%;
  height: 100%;
}
.user-header .username.data-v-7b4c7c70 {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

/* 菜单卡片样式 */
.menu-card.data-v-7b4c7c70 {
  /* 这里的 margin-bottom 也是 20rpx */
  margin-bottom: 20rpx;
  overflow: hidden;
}
.menu-card .menu-item.data-v-7b4c7c70 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 35rpx 30rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #f2f2f2;
}
.menu-card .menu-item.data-v-7b4c7c70:last-child {
  border-bottom: none;
}
.menu-card .menu-item .item-title.data-v-7b4c7c70 {
  font-size: 30rpx;
  color: #333;
}
.menu-card .menu-item .item-arrow.data-v-7b4c7c70 {
  font-size: 28rpx;
  color: #ccc;
  /* 强制不换行，确保符号显示正常 */
  white-space: nowrap;
}
.hover-class.data-v-7b4c7c70 {
  background-color: #f9f9f9 !important;
}
.footer-info.data-v-7b4c7c70 {
  margin-top: 20rpx;
}
.footer-info text.data-v-7b4c7c70 {
  font-size: 22rpx;
  color: #bbb;
}